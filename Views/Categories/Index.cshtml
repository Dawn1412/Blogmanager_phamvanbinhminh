@model Blogmanager_phamvanbinhminh.ViewModels.CategoryListViewModel

@{
    ViewData["Title"] = "Danh sách danh mục";
}

<h2 class="fw-bold mb-3">Danh sách danh mục</h2>

<!-- Nút Thêm danh mục -->
<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary rounded-pill px-3">
        <i class="bi bi-plus-circle me-1"></i> Thêm danh mục
    </a>
</div>

<!-- Form Tìm kiếm (Hỗ trợ tiếng Việt có/không dấu) -->
<form asp-action="Index" method="get" class="mb-4" style="max-width: 400px;">
    <div class="input-group">
        <span class="input-group-text bg-white text-muted border-end-0">
            <i class="bi bi-search"></i>
        </span>
        <input type="text" 
               name="search" 
               value="@Model.Search" 
               class="form-control border-start-0 ps-0" 
               placeholder="Nhập từ khóa tìm kiếm (có dấu hoặc không dấu)..." />
        <button type="submit" class="btn btn-outline-secondary px-3">Tìm</button>
    </div>
</form>

<!-- Bảng Danh mục -->
<div class="table-responsive">
    <table class="table table-hover align-middle border mb-0">
        <thead class="table-light">
            <tr>
                <th style="width: 10%;">ID</th>
                <th>Tên danh mục</th>
                <th class="text-center">Số bài viết</th>
                <th class="text-center" style="width: 35%;">Hành động</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Categories != null && Model.Categories.Any())
        {
            @foreach (var item in Model.Categories)
            {
                <tr>
                    <td>#@item.Id</td>
                    <td class="fw-semibold">@item.Name</td>
                    <td class="text-center">
                        <span class="badge bg-secondary rounded-pill">
                            @(item.Posts != null ? item.Posts.Count : 0) bài viết
                        </span>
                    </td>
                    <td class="text-center">
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary">
                                <i class="bi bi-eye"></i> Xem chi tiết
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning text-dark">
                                <i class="bi bi-pencil-square"></i> Sửa
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">
                                <i class="bi bi-trash"></i> Xóa (trang)
                            </a>
                            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Id">
                                <i class="bi bi-trash-fill"></i> Xóa (modal)
                            </button>
                        </div>

                        <!-- Modal Xác nhận Xóa -->
                        <div class="modal fade" id="deleteModal-@item.Id" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content text-start">
                                    <div class="modal-header">
                                        <h5 class="modal-title text-danger">
                                            <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận xóa
                                        </h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        Bạn có chắc chắn muốn xóa danh mục <strong>"@item.Name"</strong> không?
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-danger">Xóa luôn</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center text-muted py-4">Không tìm thấy danh mục nào.</td>
            </tr>
        }
        </tbody>
    </table>
</div>

<!-- Thanh Phân trang -->
@if (Model.TotalPages > 1)
{
    <div class="mt-3 d-flex justify-content-start">
        <ul class="pagination pagination-sm m-0">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.Search">&lsaquo;</a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@Model.Search">@i</a>
                </li>
            }

            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.Search">&rsaquo;</a>
            </li>
        </ul>
    </div>
}