@model Blogmanager_phamvanbinhminh.Models.Post

@{
    ViewData["Title"] = "Chỉnh sửa bài viết";
}

<h2 class="fw-bold mb-3">Chỉnh sửa bài viết</h2>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <!-- Hidden field giữ ID bài viết -->
            <input type="hidden" asp-for="Id" />

            <!-- 1. Tiêu đề (dùng Title thay vì Name) -->
            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-semibold">Tiêu đề</label>
                <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề..." />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <!-- 2. Danh mục -->
            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label fw-semibold">Danh mục</label>
                <select asp-for="CategoryId" class="form-select">
                    <option value="">-- Chọn danh mục --</option>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var cat in ViewBag.Categories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    }
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <!-- 3. Nội dung -->
            <div class="mb-3">
                <label asp-for="Content" class="form-label fw-semibold">Nội dung</label>
                <textarea asp-for="Content" class="form-control" rows="5" placeholder="Nhập nội dung bài viết..."></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>

            <!-- 4. Trạng thái xuất bản -->
            <div class="mb-3 form-check">
                <input asp-for="IsPublished" class="form-check-input" type="checkbox" id="isPublishedCheck" />
                <label class="form-check-label fw-semibold" for="isPublishedCheck">
                    Xuất bản ngay
                </label>
            </div>

            <!-- Nút bấm -->
            <div class="mt-4">
                <button type="submit" class="btn btn-primary px-4">Lưu thay đổi</button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Hủy bỏ</a>
            </div>
        </form>
    </div>
</div>