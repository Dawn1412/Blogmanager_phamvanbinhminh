@model Blogmanager_phamvanbinhminh.ViewModels.PostCreateViewModel

@{
    ViewData["Title"] = "Thêm bài viết";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <h2 class="fw-bold mb-3">Thêm bài viết mới</h2>
        <hr />

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Tiêu đề -->
            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-semibold">Tiêu đề</label>
                <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề bài viết..." />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <!-- Nội dung -->
            <div class="mb-3">
                <label asp-for="Content" class="form-label fw-semibold">Nội dung</label>
                <textarea asp-for="Content" class="form-control" rows="5" placeholder="Nhập nội dung bài viết..."></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>

            <!-- Tác giả -->
            <div class="mb-3">
                <label asp-for="Author" class="form-label fw-semibold">Tác giả</label>
                <input asp-for="Author" class="form-control" placeholder="Nhập tên tác giả..." />
                <span asp-validation-for="Author" class="text-danger"></span>
            </div>

            <!-- Ngày xuất bản -->
            <div class="mb-3">
                <label asp-for="PublishedAt" class="form-label fw-semibold">Ngày xuất bản</label>
                <input asp-for="PublishedAt" type="date" class="form-control" />
                <span asp-validation-for="PublishedAt" class="text-danger"></span>
            </div>

            <!-- Trạng thái (Đang xuất bản / Bản nháp) -->
            <div class="mb-4 form-check form-switch">
                <input asp-for="IsPublished" class="form-check-input" type="checkbox" role="switch" id="isPublishedSwitch" />
                <label class="form-check-label fw-semibold" for="isPublishedSwitch">Xuất bản ngay (Đang xuất bản)</label>
            </div>

            <!-- Các nút thao tác -->
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-save me-1"></i> Lưu bài viết
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-3">
                    <i class="bi bi-arrow-left me-1"></i> Hủy / Quay lại
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}