@model Blogmanager_phamvanbinhminh.ViewModels.PostListViewModel

@{
    ViewData["Title"] = "Danh sách bài viết";
}

<h2 class="fw-bold mb-3">Danh sách bài viết</h2>

<!-- Nút Thêm bài viết -->
<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary rounded-pill px-3">
        <i class="bi bi-plus-circle me-1"></i> Thêm bài viết
    </a>
</div>

<!-- Form Tìm kiếm + Sắp xếp -->
<form asp-action="Index" method="get" class="mb-4">
    <div class="row g-2">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-white text-muted border-end-0">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" 
                       name="search" 
                       value="@Model.Search" 
                       class="form-control border-start-0 ps-0" 
                       placeholder="Nhập keyword..." />
            </div>
        </div>
        <div class="col-md-4">
            <!-- Dropdown chọn kiểu sắp xếp -->
            <select name="sort" class="form-select" onchange="this.form.submit()">
                <option value="" selected="@(string.IsNullOrEmpty(Model.Sort))">Mới nhất</option>
                <option value="oldest" selected="@(Model.Sort == "oldest")">Cũ nhất</option>
                <option value="title" selected="@(Model.Sort == "title")">Theo tiêu đề (A-Z)</option>
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-outline-secondary w-100">Áp dụng</button>
        </div>
    </div>
</form>

<!-- Bảng Bài viết -->
<div class="table-responsive">
    <table class="table table-hover align-middle border mb-0">
        <thead class="table-light">
            <tr>
                <th>Tiêu đề</th>
                <th>Danh mục</th>
                <th>Thẻ</th> <!-- 🔥 Cột Thẻ mới thêm -->
                <th>Ngày xuất bản</th>
                <th>Trạng thái</th>
                <th class="text-center">Hành động</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Posts != null && Model.Posts.Any())
        {
            @foreach (var item in Model.Posts)
            {
                <tr>
                    <td class="fw-semibold">@item.Title</td>
                    
                    <!-- Hiển thị tên Danh mục -->
                    <td>
                        <span class="badge bg-info text-dark">
                            @(item.Category != null ? item.Category.Name : "Chưa phân loại")
                        </span>
                    </td>

                    <!-- 🔥 HIỂN THỊ CÁC THẺ (TAGS) 🔥 -->
                    <td>
                        @if (item.Tags != null && item.Tags.Any())
                        {
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var tag in item.Tags)
                                {
                                    <span class="badge bg-secondary">#@tag.Name</span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-muted small">Không có thẻ</span>
                        }
                    </td>

                    <td>@item.PublishedAt.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (item.IsPublished)
                        {
                            <span class="badge bg-success px-2 py-1">
                                <i class="bi bi-check-circle me-1"></i>Đang xuất bản
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary px-2 py-1">
                                <i class="bi bi-pencil-square me-1"></i>Bản nháp
                            </span>
                        }
                    </td>
                    <td class="text-center">
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary">
                                <i class="bi bi-eye"></i> Xem chi tiết
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning text-dark">
                                <i class="bi bi-pencil-square"></i> Sửa
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">
                                <i class="bi bi-trash"></i> Xóa (trang)
                            </a>
                            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Id">
                                <i class="bi bi-trash-fill"></i> Xóa (modal)
                            </button>
                        </div>

                        <!-- Modal Xóa -->
                        <div class="modal fade" id="deleteModal-@item.Id" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content text-start">
                                    <div class="modal-header">
                                        <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận xóa</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        Bạn có chắc chắn muốn xóa bài viết <strong>"@item.Title"</strong> không?
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-danger">Xóa luôn</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <!-- 🔥 Đã đổi colspan="6" cho khớp 6 cột của bảng -->
                <td colspan="6" class="text-center text-muted py-4">Chưa có dữ liệu bài viết.</td>
            </tr>
        }
        </tbody>
    </table>
</div>

<!-- Thanh Phân trang -->
@if (Model.TotalPages > 1)
{
    <div class="mt-3 d-flex justify-content-start">
        <ul class="pagination pagination-sm m-0">
            <!-- Nút Lùi (<) -->
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" 
                   asp-action="Index" 
                   asp-route-page="@(Model.CurrentPage - 1)" 
                   asp-route-search="@Model.Search" 
                   asp-route-sort="@Model.Sort">&lsaquo;</a>
            </li>

            <!-- Các số trang [1] [2] ... -->
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" 
                       asp-action="Index" 
                       asp-route-page="@i" 
                       asp-route-search="@Model.Search" 
                       asp-route-sort="@Model.Sort">@i</a>
                </li>
            }

            <!-- Nút Tới (>) -->
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" 
                   asp-action="Index" 
                   asp-route-page="@(Model.CurrentPage + 1)" 
                   asp-route-search="@Model.Search" 
                   asp-route-sort="@Model.Sort">&rsaquo;</a>
            </li>
        </ul>
    </div>
}